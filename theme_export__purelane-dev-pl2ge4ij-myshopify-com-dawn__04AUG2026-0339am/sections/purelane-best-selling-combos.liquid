<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv in">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.subheading | escape }}</p>
    </div>
    
    <div class="comborail rv in">
      {%- for block in section.blocks -%}
        {%- if block.type == 'combo' -%}
          <article class="glass combo {% if block.settings.is_hero %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
            <div class="tray">
              {%- if block.settings.save_badge != blank -%}
                <span class="save">{{ block.settings.save_badge | escape }}</span>
              {%- endif -%}
              {%- if block.settings.flag != blank -%}
                <span class="flag">{{ block.settings.flag | escape }}</span>
              {%- endif -%}
              
              <div class="stack">
                {%- for i in (1..5) -%}
                  {%- assign img_key = 'product_' | append: i | append: '_image' -%}
                  {%- assign txt_key = 'product_' | append: i | append: '_text' -%}
                  {%- assign img = block.settings[img_key] -%}
                  {%- assign txt = block.settings[txt_key] -%}
                  
                  {%- if img != blank or txt != blank -%}
                    {%- if i > 1 -%}
                      <span class="plus" aria-hidden="true">+</span>
                    {%- endif -%}
                    <span class="it">
                      {%- if img != blank -%}
                        <img src="{{ img | image_url: width: 150 }}" alt="{{ txt | escape }}" width="75" height="75" class="pimg" style="height:66px; margin:0 auto 8px; filter:drop-shadow(0 8px 13px rgba(1,24,22,.5)); object-fit:contain;">
                      {%- else -%}
                        <span class="tile">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                        </span>
                      {%- endif -%}
                      <span>{{ txt | escape }}</span>
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
            
            <div class="body">
              <h3>{{ block.settings.title | escape }}</h3>
              <div class="cnt">{{ block.settings.product_count | escape }}</div>
              <p class="inc">{{ block.settings.description | escape }}</p>
              
              <div class="prow">
                <strong>{{ block.settings.price | escape }}</strong>
                {%- if block.settings.compare_at_price != blank -%}
                  <s>{{ block.settings.compare_at_price | escape }}</s>
                {%- endif -%}
                {%- if block.settings.save_text != blank -%}
                  <em>{{ block.settings.save_text | escape }}</em>
                {%- endif -%}
              </div>
              
              <div class="fine">Inclusive of all taxes &middot; COD available</div>
              <a class="btn {% if block.settings.is_hero %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#bundles' }}">
                {{ block.settings.button_label | escape | default: 'Shop bundle' }} 
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    
    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>Swipe for more combos
    </div>
    <p class="railnote">Tapping "Shop bundle" opens the bundle picker with these products already added. You can still swap anything before you pay.</p>
  </div>
</section>

{% schema %}
{
  "name": "Best Selling Combos",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Bundle",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Bundle Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product Count Text",
          "default": "3 products"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price (e.g. ₹499)",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare at Price (e.g. ₹897)",
          "default": "₹897"
        },
        {
          "type": "text",
          "id": "save_text",
          "label": "Save Text (e.g. Save ₹398)",
          "default": "Save ₹398"
        },
        {
          "type": "text",
          "id": "save_badge",
          "label": "Top Left Save Badge",
          "default": "You save ₹398"
        },
        {
          "type": "text",
          "id": "flag",
          "label": "Top Right Flag (Optional)",
          "default": "Most popular"
        },
        {
          "type": "checkbox",
          "id": "is_hero",
          "label": "Highlight as Hero Combo?",
          "default": false
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        { "type": "header", "content": "Product 1" },
        { "type": "image_picker", "id": "product_1_image", "label": "Image" },
        { "type": "text", "id": "product_1_text", "label": "Text", "default": "Cuts grease instantly" },
        { "type": "header", "content": "Product 2" },
        { "type": "image_picker", "id": "product_2_image", "label": "Image" },
        { "type": "text", "id": "product_2_text", "label": "Text", "default": "Squeaky clean dishes" },
        { "type": "header", "content": "Product 3" },
        { "type": "image_picker", "id": "product_3_image", "label": "Image" },
        { "type": "text", "id": "product_3_text", "label": "Text" },
        { "type": "header", "content": "Product 4" },
        { "type": "image_picker", "id": "product_4_image", "label": "Image" },
        { "type": "text", "id": "product_4_text", "label": "Text" },
        { "type": "header", "content": "Product 5" },
        { "type": "image_picker", "id": "product_5_image", "label": "Image" },
        { "type": "text", "id": "product_5_text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Selling Combos",
      "blocks": [
        { "type": "combo" },
        { "type": "combo" }
      ]
    }
  ]
}
{% endschema %}
