<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv in">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    <div class="shelf">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.product_limit -%}
          <article class="glass card rv in" style="transition-delay: {{ forloop.index0 | times: 0.1 }}s;">
            <div class="shot">
              {%- if product.available == false -%}
                <span class="pill">Sold Out</span>
              {%- elsif product.compare_at_price > product.price -%}
                <span class="pill">Sale</span>
              {%- endif -%}

              {%- if product.featured_image != blank -%}
                <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.featured_image.alt | escape | default: product.title }}" width="200" height="200" loading="lazy" style="max-height: 122px; width: auto; object-fit: contain;">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <h4>{{ product.title | escape }}</h4>
            <div class="rate"><b>★ 4.8</b> · 237 reviews</div>
            <div class="pr">
              <strong>{{ product.price | money }}</strong>
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money }}</s>
                {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                <em>{{ savings }}% off</em>
              {%- endif -%}
            </div>
            
            {%- if product.available -%}
              <form method="post" action="/cart/add" class="add-to-cart-form">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" class="btn btn-ghost btn-sm">Add to cart</button>
              </form>
            {%- else -%}
              <button type="button" class="btn btn-ghost btn-sm" disabled>Sold out</button>
            {%- endif -%}
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.product_limit) -%}
          <article class="glass card rv in">
            <div class="shot">
              <span class="pill">Best seller</span>
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <h4>Example Product Title</h4>
            <div class="rate"><b>★ 4.8</b> · 120 reviews</div>
            <div class="pr"><strong>$20.00</strong></div>
            <button class="btn btn-ghost btn-sm" disabled>Add to cart</button>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum products to show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
